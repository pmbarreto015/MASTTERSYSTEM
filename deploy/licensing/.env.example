# Domínio com DNS apontado para o seu servidor Docker (compose).
LICENSE_DOMAIN=licencas.seudominio.com.br
# Gere uma credencial aleatória exclusiva com pelo menos 32 caracteres.
# O valor é usado somente no servidor e no campo de conexão do ADM.
# Nunca inclua essa credencial no APK/EXE do cliente.
LICENSE_ADMIN_TOKEN=
